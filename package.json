{
  "name": "vibe-svgs",
  "version": "0.1.0",
  "description": "Open-source animated SVG mascot, badge, and banner library.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "serve": "bunx serve .",
    "test": "bun test tests/svg-contracts.test.ts tests/svg-safety.test.ts tests/claude-code-collection.test.ts tests/official-logo-catalog.test.ts",
    "test:all": "bun test",
    "snapshots": "bun run scripts/visual-snapshots.ts",
    "visual:smoke": "bun run scripts/visual-smoke.ts",
    "svgo:check": "bun run scripts/svgo-check.ts",
    "svgo:write": "bun run scripts/svgo-check.ts --write",
    "validate": "bun run scripts/validate-svg.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run validate && bun run validate:claude-code && bun run motion:bounds && bun run typecheck && bun run svgo:check",
    "validate:claude-code": "bun run scripts/validate-svg.ts claude-code-manifest.json",
    "generate:claude-code": "python3 scripts/generate_claude_code_scenes.py && bun run svgo:write",
    "motion:bounds": "bun run scripts/audit-motion-bounds.ts claude-code-manifest.json --require-mascot",
    "motion:bounds:all": "bun run scripts/audit-motion-bounds.ts asset-manifest.json",
    "animator:setup": "bash svg-mascot-animator/scripts/setup.sh",
    "generate:mascot-packs": "bun svg-mascot-animator/scripts/generate-mascot-packs.mjs",
    "motion:bounds:packs": "bun run scripts/audit-motion-bounds.ts --glob 'svgs/packs/**/*.svg' --require-actor --samples 48",
    "sync:mascot-packs": "bun scripts/sync-mascot-packs-manifest.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.0",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "animejs": "4.5.0"
  }
}
